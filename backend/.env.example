# ============================================================================
# FLEX-Med Backend Configuration
# ============================================================================
# This file contains all configuration options for the FLEX-Med backend.
# Copy this file to .env and update the values for your environment.
#
# IMPORTANT: Never commit your actual .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase Configuration (Required)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ----------------------------------------------------------------------------
# Orchestrator URLs (Optional - for remote training orchestrators)
# ----------------------------------------------------------------------------
# If running FL orchestrators remotely (e.g., Colab via ngrok), set these URLs.
# For local deployment, use localhost URLs or comment these out.
#
# NOTE: ngrok URLs expire when the Colab session ends - update each session!

# Federated Learning Orchestrator (for federated training)
FEDERATED_TRAINING_ORCHESTRATOR_URL=http://localhost:8001

# Local Training Orchestrator (for individual client training)
LOCAL_TRAIN_ORCHESTRATOR_URL=http://localhost:8002

# ----------------------------------------------------------------------------
# Path Configuration (Optional - uses sensible defaults if not set)
# ----------------------------------------------------------------------------
# BASE_PATH: Root directory for datasets, models, and checkpoints
# Default: backend directory (or parent if backend/datasets doesn't exist)
# Example for local: /home/user/FLEX-Med/backend
# Example for server: /var/www/flex-med/backend
#BASE_PATH=/absolute/path/to/backend

# Datasets directory (for training data)
# Default: ${BASE_PATH}/datasets
#DATASETS_PATH=/absolute/path/to/datasets

# Models directory (for trained model checkpoints)
# Default: ${BASE_PATH}/models
#MODELS_PATH=/absolute/path/to/models

# Checkpoints directory (for FL intermediate checkpoints)
# Default: ${BASE_PATH}/checkpoints
#CHECKPOINTS_PATH=/absolute/path/to/checkpoints

# Default model directory for new client models
# Default: ${BASE_PATH}/models
#DEFAULT_MODEL_DIR=/absolute/path/to/models

# ----------------------------------------------------------------------------
# Federated Learning Configuration (Optional)
# ----------------------------------------------------------------------------
# Client configuration file (data.json) path
#FLEX_MED_CONFIG_FILE=/absolute/path/to/data.json

# Public anchor dataset (for FedMD knowledge distillation)
# Default: ${BASE_PATH}/datasets/cnmc/cnmc_public_anchor
#PUBLIC_ANCHOR_DATASET_PATH=/absolute/path/to/public_anchor

# Public test dataset (for evaluation)
# Default: ${BASE_PATH}/datasets/cnmc/cnmc_public_test
#PUBLIC_TEST_DATASET_PATH=/absolute/path/to/public_test

# Graphical visualization output directory
# Default: ${BASE_PATH}/graphical_visualisation
#GRAPHS_OUTPUT_DIR=/absolute/path/to/graphs

# ----------------------------------------------------------------------------
# Model Inference Configuration (Optional)
# ----------------------------------------------------------------------------
# Path to the model used for prediction endpoints
# Default: ${BASE_PATH}/models/Durdans-mobilenet-cnmc.pt
#MODEL_PATH=/absolute/path/to/inference_model.pt

# Device for model inference (cpu, cuda, mps)
# Default: cpu
#DEVICE=cpu

# Public data path (if needed for inference)
#PUBLIC_DATA_PATH=/absolute/path/to/public/data

# ----------------------------------------------------------------------------
# Application Configuration (Optional)
# ----------------------------------------------------------------------------
# Enable debug mode (verbose logging, detailed errors)
# Default: false
#DEBUG=true

# ----------------------------------------------------------------------------
# Server Deployment Example Configuration
# ----------------------------------------------------------------------------
# Uncomment and modify for production server deployment:
#
# BASE_PATH=/var/www/flex-med/backend
# DATASETS_PATH=/mnt/data/flex-med/datasets
# MODELS_PATH=/mnt/data/flex-med/models
# CHECKPOINTS_PATH=/mnt/data/flex-med/checkpoints
# DEVICE=cuda
# DEBUG=false
#
# FEDERATED_TRAINING_ORCHESTRATOR_URL=http://localhost:8001
# LOCAL_TRAIN_ORCHESTRATOR_URL=http://localhost:8002
