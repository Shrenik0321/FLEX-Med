# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Orchestrator URLs (ngrok tunnels from Colab notebooks)
# UPDATE THESE URLS EACH TIME YOU START A NEW COLAB SESSION!

# Federated Learning Orchestrator (from start_fl.ipynb)
# Copy the ngrok URL from Colab output when you run the FL orchestrator
# Example: https://abc123def456.ngrok-free.app
FEDERATED_TRAINING_ORCHESTRATOR_URL=http://localhost:8001

# Inference Orchestrator with xAI (from start_local_train.ipynb)
# Copy the ngrok URL from Colab output when you run the inference orchestrator
# Example: https://xyz789abc123.ngrok-free.app
INFERENCE_ORCHESTRATOR_URL=http://localhost:8002

# Notes:
# - ngrok URLs expire when the Colab session ends
# - You must update these URLs before using /start_fl or /upload-xai endpoints
# - For local development/testing, keep the localhost URLs
